return {
  summary = "One modular accessibility hub for keyboard and gamepad. Everything ships OFF.",
  author = "ojsaucer",
  tags = { "input", "accessibility", "hotkeys", "gamepad", "keyboard" },
  differences = {
    changed = {
      "OPTIONS gains one HOTKEY SUITE entry with input, feature, and settings submenus",
      "menu hotkeys and the radial menu discover every live START-menu item, including mod-added entries",
    },
    added = {
      "every module carries an ENABLED master switch that ships OFF with no hotkey bound",
      "keyboard/gamepad autofire hotkeys and menu hotkeys",
      "gamepad radial menu with either-stick selection and LT/RT-capable binding",
      "keyboard and gamepad travel shortcuts for Fly, Pokemon Center return, and Bicycle",
      "battle command, instant-Run, and auto battle text advance for keyboard and gamepad",
      "a single-line battle ball selector with a quick-throw alternative",
      "confirmed suite-wide unassignment and configurable radial placement",
      "an optional Start Menu entry that Kanto Ascendant relocates into its own ASCENDANT hub when installed",
      "a feature registry for adding future accessibility modules without rebuilding the menu hierarchy",
    },
    known = {
      "the superseded standalone autofire_hotkey, menu_hotkeys, and radial_menu mods must remain disabled",
      "nothing in the suite reacts to input until a module is switched ON and a hotkey is assigned",
    },
  },
  credits = {
    "Consolidates the Autofire Hotkey, Menu Hotkeys, and Radial Menu designs.",
  },
  compat = { engine = ">=1.0.0 <2.0.0", modApi = 2 },
}
